---
persistence:
  storageClassName: longhorn-protected
  size: 40Gi

dynmap:
  enabled: true
  cores: 12
  showOfflinePlayers: true
  showSpawnBeds: true
  config:
    resources:
      requests:
        cpu: 10m
        memory: 10Mi
      limits:
        memory: 30Mi
    securityContext:
      allowPrivilegeEscalation: false
      capabilities:
        drop:
          - ALL
  httpRoute:
    enabled: true
    parentRefs:
      - name: "{{ gateway_name }}"
        namespace: "{{ gateway_namespace }}"
        sectionName: https-wildcard
    hostnames:
      - "niucraft.{{ external_domain }}"
    filters:
      - type: ResponseHeaderModifier
        responseHeaderModifier:
          set:
{% for header in gateway_response_headers %}
            - name: "{{ header.name }}"
              value: "{{ header.value }}"
{% endfor %}

metrics:
  enabled: true
  dashboard:
    enabled: true
  serviceMonitor:
    enabled: true

properties:
  aikarFlags: true
  enforceWhitelist: true
  memory: "6G"
  motd: "NIUCraft Server"
  ops: "Barrelmaker97"
  existingWhitelist: "SYNCHRONIZE"
  existingOps: "SYNCHRONIZE"
  paperChannel: "default"
  serverName: "NIUCraft"
  modrinthProjects: >-
    fabric-api,
    fabricexporter,
    spark,
    chunky,
    dynmap
  type: "FABRIC"
  version: "1.21.11"
  viewDistance: "32"
  whitelist: >-
    BakerGang2022,
    Barrelmaker97,
    Lil_Doza,
    LuckierDodge,
    Solo22499,
    Spronix,
    ThePrimeus,
    Celery_Trainer,
    ninjahomie7

podSecurityContext:
  seccompProfile:
    type: RuntimeDefault
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000

securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL

service:
  type: LoadBalancer
  port: 25565

resources:
  requests:
    cpu: 1000m
    memory: 7500Mi
  limits:
    memory: 8000Mi
