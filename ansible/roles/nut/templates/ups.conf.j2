maxretry = 3

[{{ nut_ups_name }}]
  driver = {{ nut_ups_driver }}
  port = {{ nut_ups_port }}
  desc = "{{ nut_ups_desc }}"
  ignorelb
  override.battery.runtime.low = {{ nut_ups_runtime_low }}
  override.battery.charge.low = {{ nut_ups_charge_low }}
  offdelay = {{ nut_ups_offdelay }}
  ondelay = {{ nut_ups_ondelay }}
